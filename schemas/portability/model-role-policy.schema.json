{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/portability/model-role-policy.schema.json",
  "title": "PstackModelRolePolicy",
  "description": "Declarative model/role intent; runtime selection requires separate detection and receipts. Does not imply model availability.",
  "type": "object",
  "required": [
    "version",
    "roles",
    "hosts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "canonical_source": {
      "type": "object",
      "required": [
        "repository",
        "pin"
      ],
      "properties": {
        "repository": {
          "const": "cursor/plugins"
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "selection",
          "tier",
          "required_capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "enum": [
              "single",
              "panel",
              "cross-judge"
            ]
          },
          "tier": {
            "enum": [
              "fast-worker",
              "balanced",
              "strongest",
              "panel",
              "inherit-parent"
            ]
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimum_independent_workers": {
            "type": "integer",
            "minimum": 1
          },
          "require_distinct_model_families": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "discovery",
            "model_catalog",
            "tier_defaults",
            "fallback"
          ],
          "properties": {
            "discovery": {
              "enum": [
                "live",
                "catalog",
                "unverified"
              ]
            },
            "model_catalog": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "provider",
                  "family"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "family": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supported_efforts": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_ref": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "tier_defaults": {
              "type": "object",
              "properties": {
                "fast-worker": {
                  "$ref": "#/$defs/modelChoices"
                },
                "balanced": {
                  "$ref": "#/$defs/modelChoices"
                },
                "strongest": {
                  "$ref": "#/$defs/modelChoices"
                },
                "panel": {
                  "$ref": "#/$defs/modelChoices"
                },
                "inherit-parent": {
                  "$ref": "#/$defs/modelChoices"
                }
              },
              "additionalProperties": false
            },
            "role_overrides": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
                  "type": "object",
                  "required": [
                    "models"
                  ],
                  "properties": {
                    "models": {
                      "$ref": "#/$defs/modelChoices"
                    },
                    "effort": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "fallback": {
              "enum": [
                "inherit-parent",
                "fail-closed"
              ]
            },
            "verification_status": {
              "enum": [
                "unverified",
                "static-only",
                "verified",
                "stale"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "allow_unverified_models": {
          "const": false
        },
        "require_review_for_configured_cross_judge_diversity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "modelChoices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
