{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/portability/model-role-policy.schema.json",
  "title": "PstackModelRolePolicy",
  "description": "Host-resolved model policy extending pstack.package.json#/roles without a duplicate role registry. Static catalogs are not runtime availability evidence.",
  "type": "object",
  "required": [
    "version",
    "role_source",
    "hosts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "canonical_source": {
      "type": "object",
      "required": [
        "repository",
        "pin"
      ],
      "properties": {
        "repository": {
          "const": "cursor/plugins"
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "role_source": {
      "const": "pstack.package.json#/roles"
    },
    "role_constraints": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "type": "object",
          "properties": {
            "selection": {
              "enum": [
                "single",
                "panel",
                "cross-judge"
              ]
            },
            "required_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minimum_independent_workers": {
              "type": "integer",
              "minimum": 1
            },
            "require_distinct_model_families": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "discovery",
            "model_catalog",
            "tier_defaults",
            "fallback"
          ],
          "properties": {
            "discovery": {
              "enum": [
                "live",
                "catalog",
                "unverified"
              ]
            },
            "model_catalog": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "provider",
                  "family"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "family": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supported_efforts": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_ref": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "tier_defaults": {
              "type": "object",
              "description": "Keys must match default_model_role values from pstack.package.json#/roles; cross-document agreement is enforced by the validator.",
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
                  "$ref": "#/$defs/modelChoices"
                }
              },
              "additionalProperties": false
            },
            "role_overrides": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
                  "type": "object",
                  "required": [
                    "models"
                  ],
                  "properties": {
                    "models": {
                      "$ref": "#/$defs/modelChoices"
                    },
                    "effort": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "fallback": {
              "enum": [
                "inherit-parent",
                "fail-closed"
              ]
            },
            "verification_status": {
              "enum": [
                "unverified",
                "static-only",
                "verified",
                "stale"
              ]
            },
            "catalog_observation": {
              "type": "object",
              "properties": {
                "host_version": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "receipt": {
                  "type": "string"
                },
                "implementation_revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "additionalProperties": false,
              "required": [
                "host_version",
                "observed_at",
                "receipt"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "allow_unverified_models": {
          "const": false
        },
        "require_review_for_configured_cross_judge_diversity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "modelChoices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
