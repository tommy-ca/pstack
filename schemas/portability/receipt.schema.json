{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/portability/receipt.schema.json",
  "title": "VerificationReceipt",
  "description": "Durable verification receipt recording conformance verdicts, scenario results, and proven surface revisions.",
  "type": "object",
  "required": [
    "run_id",
    "host",
    "host_version",
    "timestamp",
    "overall_verdict",
    "planes",
    "surface_revisions",
    "scenarios",
    "artifacts"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "host": {
      "type": "string",
      "enum": ["grok", "codex", "omp", "opencode", "antigravity", "droid", "claude", "custom", "mock"]
    },
    "host_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "UNTESTED"]
    },
    "planes": {
      "type": "object",
      "required": ["canonical", "adapter", "package", "runtime"],
      "properties": {
        "canonical": { "type": "string", "enum": ["PASS", "FAIL", "UNTESTED", "BLOCKED"] },
        "adapter": { "type": "string", "enum": ["PASS", "FAIL", "UNTESTED", "BLOCKED"] },
        "package": { "type": "string", "enum": ["PASS", "FAIL", "UNTESTED", "BLOCKED"] },
        "runtime": { "type": "string", "enum": ["PASS", "FAIL", "UNTESTED", "BLOCKED"] }
      },
      "additionalProperties": false
    },
    "surface_revisions": {
      "type": "object",
      "required": [
        "canonical_pin",
        "upstream_head",
        "spec_hash",
        "skills_tree_hash",
        "profile_hash",
        "package_descriptor_hash",
        "manifest_hash",
        "driver_revision",
        "package_driver_revision",
        "boundary_driver_revision"
      ],
      "properties": {
        "canonical_pin": { "type": "string" },
        "upstream_head": { "type": "string" },
        "spec_hash": { "type": "string" },
        "skills_tree_hash": { "type": "string" },
        "profile_hash": { "type": "string" },
        "package_descriptor_hash": { "type": "string" },
        "manifest_hash": { "type": "string" },
        "driver_revision": { "type": "string" },
        "package_driver_revision": { "type": "string" },
        "boundary_driver_revision": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "plane", "command", "exit_code", "stdout_snippet", "verdict", "duration_s", "evidence_level"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "plane": { "type": "string", "enum": ["canonical", "adapter", "package", "runtime"] },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "stdout_snippet": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "UNTESTED"] },
          "duration_s": { "type": "number" },
          "evidence_level": {
            "type": "string",
            "enum": ["static", "offline", "observed_live", "legacy"],
            "description": "How the scenario evidence was obtained. Only observed_live records a host runtime actually being observed, so only observed_live can prove the derived 'verified' support state; static/offline/legacy evidence proves at most 'packaged'. Receipts predating this field are read as legacy."
          },
          "settlement": {
            "type": ["object", "null"],
            "required": ["child_id", "terminal_outcome", "model", "transport", "effective_rpc"],
            "properties": {
              "child_id": { "type": "string", "minLength": 1 },
              "terminal_outcome": { "type": "string", "enum": ["success", "error", "timeout", "cancelled"] },
              "model": { "type": "string", "minLength": 1 },
              "transport": { "type": "string", "enum": ["rpc", "sdk", "cli"] },
              "effective_rpc": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false,
            "description": "Typed child spawn/join proof. Required on runtime observed_live scenarios before they count toward derived verified; free-text stdout alone never promotes."
          },
          "preserved_from": {
            "type": "string",
            "description": "run_id whose observed_live scenario was carried into a later refresh because the runtime surface it proved had not moved. Empty on a scenario this run observed itself."
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claim": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
