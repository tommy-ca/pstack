{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/portability/binding.schema.json",
  "title": "Binding",
  "description": "An adapter binding of a portable capability to host primitives.",
  "type": "object",
  "required": ["host", "capability", "implementation_status", "enforcement", "verification_status"],
  "properties": {
    "host": {
      "$ref": "host-id.schema.json#/$defs/host"
    },
    "capability": {
      "type": "string",
      "enum": [
        "agent.spawn",
        "agent.join",
        "agent.message",
        "agent.cancel",
        "agent.resume",
        "workspace.shared",
        "workspace.isolated",
        "workspace.readonly",
        "human.ask",
        "human.gate",
        "plan.update",
        "schedule",
        "monitor",
        "session.persist",
        "session.resume",
        "evidence.capture",
        "verify"
      ]
    },
    "implementation_status": {
      "type": "string",
      "enum": ["native", "shim", "version-gated", "gap"]
    },
    "primitive": {
      "type": ["string", "null"]
    },
    "enforcement": {
      "type": "string",
      "enum": ["hard", "soft", "advisory"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "static-only", "unverified", "stale"]
    },
    "evidence_ref": {
      "description": "Where the claim is proven. A receipt-only string names a durable receipt path; the object form pins the exact scenario that settles the capability, and a scenario the receipt does not record is a dangling reference.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Receipt path only. Proves the receipt exists; it pins no scenario."
        },
        {
          "type": "object",
          "required": ["receipt", "scenario"],
          "properties": {
            "receipt": {
              "type": "string",
              "minLength": 1,
              "description": "Path to the durable receipt, relative to the repository root."
            },
            "scenario": {
              "type": "string",
              "minLength": 1,
              "description": "Scenario id inside that receipt which settles this binding."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
