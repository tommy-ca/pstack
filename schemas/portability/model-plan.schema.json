{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/portability/model-plan.schema.json",
  "title": "ModelPlan",
  "description": "Pure planning-only output for harness adapters. Never evidence of live model dispatch, verified isolation or agent completion.",
  "type": "object",
  "required": [
    "host",
    "role",
    "selection",
    "source",
    "status",
    "seats",
    "reasons",
    "effort",
    "evidence_level"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "enum": [
        "single",
        "panel",
        "cross-judge",
        "unknown"
      ]
    },
    "source": {
      "enum": [
        "explicit",
        "project",
        "user",
        "host-role",
        "host-tier",
        "inherit-parent",
        "none"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "DEGRADED",
        "BLOCKED"
      ]
    },
    "seats": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "model",
          "family",
          "provider"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "family": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "type": "null"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "family": {
                  "type": "null"
                },
                "provider": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "family",
                "provider"
              ]
            }
          }
        ]
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effort": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_level": {
      "const": "static-planning-only"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
      "then": {"properties": {"seats": {"maxItems": 0}, "reasons": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["PLANNED", "DEGRADED"]}}, "required": ["status"]},
      "then": {"properties": {"seats": {"minItems": 1}}, "not": {"properties": {"source": {"const": "none"}}}}
    },
    {
      "if": {"properties": {"selection": {"const": "single"}}, "required": ["selection"]},
      "then": {"properties": {"seats": {"maxItems": 1}}}
    },
    {
      "if": {"properties": {"selection": {"const": "cross-judge"}}, "required": ["selection"]},
      "then": {"properties": {"seats": {"maxItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "DEGRADED"}}, "required": ["status"]},
      "then": {"properties": {"reasons": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
