{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/schemas/setup-projection.schema.json",
  "title": "SetupProjection",
  "description": "Where a harness host declares its model and reasoning-effort setup surface. A declaration of surface, never a capability or runtime claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "effort"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["host-cli", "host-catalog", "inherit", "none"]
    },
    "effort": {
      "type": "string",
      "enum": ["live-enum", "inherit-parent", "none"]
    },
    "catalog": { "type": ["string", "null"] },
    "overlay": { "type": ["string", "null"] }
  },
  "oneOf": [
    {
      "properties": {
        "source": { "const": "host-cli" },
        "effort": { "const": "live-enum" },
        "catalog": { "type": "string", "minLength": 3, "pattern": "^~/" },
        "overlay": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 3, "pattern": "^~/" }
          ]
        }
      },
      "required": ["catalog"]
    },
    {
      "properties": {
        "source": { "const": "host-catalog" },
        "effort": { "const": "none" },
        "catalog": { "type": "string", "minLength": 2, "pattern": "^[^~/]" },
        "overlay": { "const": null }
      },
      "required": ["catalog"]
    },
    {
      "properties": {
        "source": { "const": "inherit" },
        "effort": { "const": "inherit-parent" },
        "catalog": { "const": null },
        "overlay": { "const": null }
      }
    },
    {
      "properties": {
        "source": { "const": "none" },
        "effort": { "const": "none" },
        "catalog": { "const": null },
        "overlay": { "const": null }
      }
    }
  ]
}
