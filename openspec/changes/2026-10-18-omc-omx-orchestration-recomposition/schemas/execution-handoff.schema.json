{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/proposals/orchestration/execution-handoff.schema.json",
  "title": "Proposed Bounded Native Execution Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "attempt_id",
    "generation",
    "dispatch_key",
    "graph_digest",
    "context_digest",
    "model_plan_ref",
    "standing_orders",
    "input_artifacts",
    "acceptance_ids",
    "workspace",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "dispatch_key": {
      "type": "string",
      "minLength": 1
    },
    "graph_digest": {
      "$ref": "#/$defs/digest"
    },
    "context_digest": {
      "$ref": "#/$defs/digest"
    },
    "model_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "standing_orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "digest",
          "uri",
          "producer_attempt_id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "$ref": "#/$defs/id"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "producer_attempt_id": {
            "$ref": "#/$defs/id"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "workspace": {
      "type": "object",
      "required": [
        "kind",
        "owner"
      ],
      "properties": {
        "kind": {
          "enum": [
            "readonly",
            "isolated",
            "exclusive"
          ]
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
