{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pstack.dev/proposals/orchestration/semantic-graph.schema.json",
  "title": "Proposed Host Semantic Graph Revision",
  "description": "Proposed schema; structural validation only. Runtime must validate referential integrity, permitted bounded cycles and descriptor digest independently.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "revision",
    "owner_host",
    "descriptor_digest",
    "nodes",
    "control_edges",
    "artifact_edges",
    "acceptance_predicate_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "graph_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_host": {
      "$ref": "#/$defs/id"
    },
    "descriptor_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "objective",
              "timeout_ms",
              "max_attempts",
              "effect_policy"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "agent"
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 100
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "effect_policy": {
                "$ref": "#/$defs/effect"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "command",
              "timeout_ms",
              "max_attempts",
              "effect_policy"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "command"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 100
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "effect_policy": {
                "$ref": "#/$defs/effect"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "prompt"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "human-approval"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "fanout_id",
              "branch_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "join"
              },
              "fanout_id": {
                "$ref": "#/$defs/id"
              },
              "branch_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "control_edges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "from",
              "to"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "fixed",
                  "fanout"
                ]
              },
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "from",
              "to",
              "route"
            ],
            "properties": {
              "kind": {
                "const": "conditional"
              },
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "from",
              "to",
              "route",
              "max_traversals"
            ],
            "properties": {
              "kind": {
                "const": "back_edge"
              },
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "max_traversals": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "artifact_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "artifact_type"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "artifact_type": {
            "$ref": "#/$defs/id"
          },
          "required_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_predicate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "const": "side_effect_free"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "policy",
            "idempotency_key_template"
          ],
          "properties": {
            "policy": {
              "const": "idempotent"
            },
            "idempotency_key_template": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "const": "reconcile"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
