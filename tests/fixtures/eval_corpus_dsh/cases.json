        {
          "role": "required",
          "kind": "pattern",
          "scope": [
            "skills/create-verification-skill/SKILL.md"
          ],
          "pattern": "Atomic allocation",
          "control": {
            "text": "we allocate the port",
            "expect_match": false
          }
